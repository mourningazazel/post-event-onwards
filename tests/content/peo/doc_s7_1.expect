mechanic.modifier.state.charred	name_part.order	integer	10
mechanic.modifier.state.charred	name_part.text	string	charred
mechanic.modifier.state.charred	tags.0	path	def.tag.state.charred
mechanic.modifier.state.charred	effects.0	expr	$item.durability.multiply(50%)
