#version 450
#extension GL_GOOGLE_include_directive : require
// PEO-081, PEO-087: one round of the scent wave's pull for every cell, as ScentWave's CPU
// pull does it (pull_row and pull_border_cell, calm; pull_row_wind and wind_offer under
// a wind): integer max and subtraction only, so every GPU gives the CPU's bits. A cell
// takes the best offer of its neighbours if it beats its own value and the age line.
// Orthogonal neighbours offer whenever they are on the map; a diagonal only through the
// cell's corner mask (PEO-044).
//
// Dispatched in two dimensions: a workgroup is 64 cells of one row, which the backend
// keeps inside one pull tile (the tile width is a multiple of 64). The group gathers
// "something changed" in shared memory, and one lane records the round in the tile's
// flag (atomicMax), so a saturated field costs one global atomic per group, not per cell.

#include "wave_common.glsl"

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer Masks { uint masks[]; };
layout(std430, set = 0, binding = 1) readonly buffer In { int a[]; };
layout(std430, set = 1, binding = 0) writeonly buffer Out { int b[]; };
layout(std430, set = 1, binding = 1) buffer Flags { uint flags[]; };
layout(std140, set = 2, binding = 0) uniform Params {
    int width;
    int height;
    int tiles_x;
    int tile_width;
    int tile_height;
    int cost;
    int line;
    uint round_plus_one;
    ivec4 step_lo; // the wind step per neighbour slot 0-3, then 4-7
    ivec4 step_hi;
    uint allowed;   // neighbour slots this round carries (all in a full round)
    uint need_open; // a gust round: only outdoor senders offer
    uint windy;
    uint pad;
};

shared uint group_changed;

void main() {
    if (gl_LocalInvocationID.x == 0u) {
        group_changed = 0u;
    }
    barrier();
    const int x = int(gl_GlobalInvocationID.x);
    const int y = int(gl_GlobalInvocationID.y);
    if (x < width && y < height) {
        const int i = y * width + x;
        const int old = a[i];
        const uint m = masks[i];
        int v = old;
        if ((m & 1u) != 0u) {
            const int steps[8] = int[8](step_lo.x, step_lo.y, step_lo.z, step_lo.w, step_hi.x, step_hi.y,
                                        step_hi.z, step_hi.w);
            const ivec2 nb[8] = ivec2[8](ivec2(0, -1), ivec2(1, -1), ivec2(1, 0), ivec2(1, 1), ivec2(0, 1),
                                         ivec2(-1, 1), ivec2(-1, 0), ivec2(-1, -1));
            const uint corners = m >> kDiagShift;
            int best = kUnreached;
            for (int k = 0; k < 8; ++k) {
                const int nx = x + nb[k].x;
                const int ny = y + nb[k].y;
                const bool diagonal = (k & 1) == 1;
                if (nx < 0 || ny < 0 || nx >= width || ny >= height ||
                    (diagonal && ((corners >> uint(k / 2)) & 1u) == 0u)) {
                    continue;
                }
                const int n = ny * width + nx;
                best = max(best, offer(a[n], masks[n], k, cost, steps[k], allowed, need_open, windy));
            }
            if (best > line && best > old) {
                v = best;
                atomicOr(group_changed, 1u);
            }
        }
        b[i] = v;
    }
    barrier();
    if (gl_LocalInvocationID.x == 0u && group_changed != 0u) {
        atomicMax(flags[uint((y / tile_height) * tiles_x + x / tile_width)], round_plus_one);
    }
}
